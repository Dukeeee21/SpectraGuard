# Copiar a .env y completar con valores reales. NUNCA commitear el .env real.

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# --- PostgreSQL ---
POSTGRES_DB=spectraguard
POSTGRES_USER=spectraguard_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- ML ---
MODEL_WEIGHTS_PATH=ml/weights/hybrid_detector_v1.pth
MODEL_DEVICE=cuda   # "cuda" si hay GPU disponible, "cpu" en su defecto
INFERENCE_IMAGE_SIZE=224
