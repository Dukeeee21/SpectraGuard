# Copiar a .env y completar con valores reales. NUNCA commitear el .env real.

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# --- PostgreSQL ---
POSTGRES_DB=spectraguard
POSTGRES_USER=spectraguard_user
POSTGRES_PASSWORD=change-me
# 5433, no 5432: el contenedor db de docker-compose se mapea ahí porque el
# 5432 puede estar ocupado por un PostgreSQL nativo instalado en la máquina.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- ML ---
MODEL_WEIGHTS_PATH=ml/weights/hybrid_detector_v1.pth
MODEL_DEVICE=cpu   # cambiar a "cuda" si la maquina tiene GPU compatible
INFERENCE_IMAGE_SIZE=224
